generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Guest {
  id        String   @id @default(cuid())
  name      String   @unique
  drinks    Int      @default(11)
  bets      Bet[]    @relation("Creator")
  wagers    Wager[]
  createdAt DateTime @default(now())
}

enum BetStatus {
  OPEN
  PENDING_VALIDATION
  RESOLVED
}

model Bet {
  id          String    @id @default(cuid())
  title       String
  description String?
  deadline    DateTime
  status      BetStatus @default(OPEN)
  winnerId    String?
  closedAt    DateTime?
  creatorId   String
  creator     Guest     @relation("Creator", fields: [creatorId], references: [id])
  options     Option[]
  wagers      Wager[]
  createdAt   DateTime  @default(now())
}

model Option {
  id          String  @id @default(cuid())
  label       String
  probability Float   @default(50)
  betId       String
  bet         Bet     @relation(fields: [betId], references: [id], onDelete: Cascade)
  wagers      Wager[]
}

model Wager {
  id        String   @id @default(cuid())
  amount    Int
  claimed   Boolean  @default(false)
  guestId   String
  betId     String
  optionId  String
  guest     Guest    @relation(fields: [guestId], references: [id])
  bet       Bet      @relation(fields: [betId], references: [id], onDelete: Cascade)
  option    Option   @relation(fields: [optionId], references: [id])
  createdAt DateTime @default(now())
  @@index([betId])
  @@index([guestId])
}
